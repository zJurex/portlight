{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "portlight",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true, "head_sampling_rate": 0.05 },
  // Los archivos estáticos no cuentan como requests de Workers; solo /api/* ejecuta el Worker.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "WORLD", "class_name": "World" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["World"] }],
  "vars": {
    "PREMIUM_ENABLED": "false",
    "DAILY_REQUEST_BUDGET": "100000"
  }
}
